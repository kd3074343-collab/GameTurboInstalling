<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GameTurboPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryDark">@color/bg_amoled</item>
        <item name="colorAccent">@color/neon_crimson</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_amoled</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_high</item>
        <item name="colorOnPrimary">@color/bg_amoled</item>

        <!-- Status & Navigation bars -->
        <item name="android:statusBarColor">@color/bg_amoled</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Bottom Navigation View -->
        <item name="bottomNavigationStyle">@style/Widget.GameTurboPro.BottomNavigationView</item>
    </style>

    <style name="Theme.MyApplication" parent="Theme.GameTurboPro" />

    <style name="Widget.GameTurboPro.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bg_surface</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="itemRippleColor">#3300F0FF</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="GamingHUDCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/border_glass</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">14dp</item>
    </style>

    <style name="GamingAccentCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card_elevated</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/border_glow_cyan</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

</resources>
